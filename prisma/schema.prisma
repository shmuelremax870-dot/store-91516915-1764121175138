// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AccountHolderStatus {
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  TERMINATED
}

enum Platform {
  ETSY
  SHOPIFY
}

enum StoreStatus {
  CREATING
  WARMING_UP
  ACTIVE
  PAUSED
  SUSPENDED
  TERMINATED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  PAUSED
  REMOVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TorahFundStatus {
  PENDING
  APPROVED
  PAID
  CLAWED_BACK
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  BANK_TRANSFER
  BIT
  PAYBOX
  PAYPAL
}

enum CompetitionLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProxyStatus {
  ACTIVE
  ROTATING
  EXPIRED
}

enum ApiProvider {
  ETSY
  SHOPIFY
  PRINTFUL
  PRINTIFY
  GOOTEN
  SPOD
  PROXY
  OPENROUTER
  PAYMENT
  OTHER
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

/// Passive identity providers from Haredi community in Israel
model AccountHolder {
  id             String              @id @default(cuid())
  fullName       String
  teudatZehut    String              @unique
  email          String              @unique
  phone          String
  address        String
  city           String
  bankName       String
  bankAccount    String
  bankBranch     String
  bitPhone       String?
  status         AccountHolderStatus @default(PENDING_VERIFICATION)
  maxStores      Int                 @default(5)
  torahFundRate  Float               @default(0.05)
  totalEarned    Float               @default(0)
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  stores     Store[]
  torahFunds TorahFund[]
  payouts    Payout[]

  @@index([status])
  @@index([city])
}

/// Etsy/Shopify stores linked to account holders
model Store {
  id              String      @id @default(cuid())
  accountHolderId String
  platform        Platform
  storeName       String
  storeUrl        String
  nicheId         String?
  status          StoreStatus @default(CREATING)
  healthScore     Int         @default(100)
  etsyStoreId     String?
  shopifyStoreId  String?
  mirrorStoreId   String?     @unique
  listingCount    Int         @default(0)
  totalRevenue    Float       @default(0)
  totalOrders     Int         @default(0)
  warmupWeek      Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  accountHolder AccountHolder @relation(fields: [accountHolderId], references: [id])
  niche         Niche?        @relation(fields: [nicheId], references: [id])
  mirrorStore   Store?        @relation("StoreMirror", fields: [mirrorStoreId], references: [id])
  mirroredBy    Store?        @relation("StoreMirror")
  products      Product[]
  orders        Order[]
  torahFunds    TorahFund[]
  proxyProfile  ProxyProfile?

  @@index([accountHolderId])
  @@index([status])
  @@index([platform])
  @@index([nicheId])
  @@index([platform, status])
}

/// Product listings on stores
model Product {
  id               String        @id @default(cuid())
  storeId          String
  title            String
  description      String
  price            Float
  cost             Float
  podProviderId    String?
  podProductId     String?
  designFileUrl    String?
  etsyListingId    String?
  shopifyProductId String?
  status           ProductStatus @default(DRAFT)
  tags             String[]
  category         String?
  views            Int           @default(0)
  favorites        Int           @default(0)
  sales            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@index([storeId])
  @@index([status])
  @@index([storeId, status])
  @@index([category])
}

/// Orders from both Etsy and Shopify platforms
model Order {
  id              String      @id @default(cuid())
  storeId         String
  productId       String?
  platform        Platform
  orderNumber     String
  customerName    String
  customerEmail   String
  customerAddress String
  amount          Float
  podCost         Float
  platformFees    Float
  profit          Float
  podProvider     String?
  podOrderId      String?
  trackingNumber  String?
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store     Store      @relation(fields: [storeId], references: [id])
  product   Product?   @relation(fields: [productId], references: [id])
  torahFund TorahFund?

  @@index([storeId])
  @@index([status])
  @@index([platform])
  @@index([storeId, status])
  @@index([orderNumber])
  @@index([createdAt])
}

/// 5% Torah fund commission per order
model TorahFund {
  id              String          @id @default(cuid())
  accountHolderId String
  orderId         String          @unique
  storeId         String
  saleAmount      Float
  fundRate        Float           @default(0.05)
  fundAmount      Float
  status          TorahFundStatus @default(PENDING)
  payoutId        String?
  createdAt       DateTime        @default(now())

  accountHolder AccountHolder @relation(fields: [accountHolderId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  payout        Payout?       @relation(fields: [payoutId], references: [id])

  @@index([accountHolderId])
  @@index([storeId])
  @@index([status])
  @@index([payoutId])
  @@index([createdAt])
}

/// Monthly payouts to account holders
model Payout {
  id              String        @id @default(cuid())
  accountHolderId String
  amountUsd       Float
  amountIls       Float
  exchangeRate    Float
  paymentMethod   PaymentMethod
  reference       String?
  status          PayoutStatus  @default(PENDING)
  createdAt       DateTime      @default(now())

  accountHolder AccountHolder @relation(fields: [accountHolderId], references: [id])
  torahFunds    TorahFund[]

  @@index([accountHolderId])
  @@index([status])
  @@index([createdAt])
}

/// Store niche categories for targeting
model Niche {
  id               String           @id @default(cuid())
  name             String
  description      String?
  keywords         String[]
  avgMargin        Float
  competitionLevel CompetitionLevel
  trendingScore    Int              @default(50)
  productCount     Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  stores Store[]

  @@index([isActive])
  @@index([competitionLevel])
}

/// Anti-detect browser profiles per store for identity isolation
model ProxyProfile {
  id              String      @id @default(cuid())
  storeId         String      @unique
  proxyIp         String
  proxyPort       Int
  proxyUsername   String
  proxyPassword   String
  browserProfile  String
  userAgent       String
  fingerprintHash String
  cookies         Json?
  lastUsed        DateTime?
  status          ProxyStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([status])
}

/// API keys and secrets management for the admin secrets bar
model ApiSecret {
  id            String      @id @default(cuid())
  name          String
  provider      ApiProvider
  apiKey        String
  apiSecret     String?
  accessToken   String?
  refreshToken  String?
  webhookSecret String?
  metadata      Json?
  isActive      Boolean     @default(true)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([provider])
  @@index([isActive])
  @@index([provider, isActive])
}

/// Audit log to track all admin actions
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  details     Json?
  performedBy String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
}
